{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-icon",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
